{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunarmarch.local/schemas/task-contract.schema.json",
  "title": "LunarMarch task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "phase",
    "objective",
    "role_hint",
    "risk",
    "allowed_paths",
    "acceptance_commands",
    "requirements",
    "inputs",
    "non_goals",
    "depends_on"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "phase": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "role_hint": {
      "enum": ["scout", "builder", "reviewer", "fixer", "verifier", "sentinel", "recovery", "auditor", "clerk"]
    },
    "risk": { "enum": ["trivial", "routine", "medium", "high"] },
    "allowed_paths": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "acceptance_commands": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "inputs": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "non_goals": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "depends_on": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
    }
  }
}
